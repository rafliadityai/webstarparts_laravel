DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always generate SEO endpoints dynamically; static robots.txt remains a fallback
    # for hosts that do not enable mod_rewrite.
    RewriteRule ^robots\.txt$ robots.php [QSA,L]
    RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

    # Do not rewrite other real files/directories.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SEO-friendly public URLs.
    RewriteRule ^produk/([^/]+)/?$ product.php?slug=$1 [QSA,L,B]
    RewriteRule ^berita/([a-zA-Z0-9-]+)/?$ news-detail.php?slug=$1 [QSA,L]

</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

Options -Indexes

# Internal/source files must never be served publicly.
<FilesMatch "\.(sql|md|log|bak|ini)$">
    Require all denied
</FilesMatch>

# Protect the optional local configuration file containing database credentials.
<Files "config.local.php">
    Require all denied
</Files>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
